APP_NAME=NexABI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexabi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ---------------------------------------------------------------------------
# Queue
#
# `sync` runs jobs inline on the request — right for local work, so a reminder
# sweep lands in Mailtrap the moment you click it with no worker running.
#
# On Laravel Cloud set this to `database` and add a Worker process running
# `php artisan queue:work --queue=mail,default --tries=3`. Nothing in the code
# changes; the bulk mail paths already dispatch rather than send.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
#
# ACTIVE: Mailtrap. Catches everything in a shared inbox instead of delivering
# it, so a reminder sweep across the whole book is safe to run against
# real-looking addresses. Credentials are in
# Mailtrap > Email Testing > Inboxes > SMTP Settings > Laravel.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@nexabi.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Mail — Resend (for real delivery, when testing is finished)
#
# Three steps:
#   1. composer require resend/resend-laravel
#   2. verify your sending domain in the Resend dashboard
#   3. uncomment the four lines below and comment out MAIL_MAILER=smtp above
#
# Nothing else changes — every Mailable goes out over Resend's HTTP API instead
# of SMTP, so there is no port to open and no TLS to negotiate. Sending from an
# unverified domain returns 403 on every message.
# ---------------------------------------------------------------------------
# MAIL_MAILER=resend
# RESEND_API_KEY=re_...
# MAIL_FROM_ADDRESS="hello@yourverifieddomain.com"
# MAIL_FROM_NAME="${APP_NAME}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Language generation — OpenAI
#
# Leave the key blank and App\Ai\TemplateNarrator writes the prose
# deterministically; the product is fully functional without it. Paste a key
# and App\Ai\OpenAiNarrator takes over, with the templated narrator still
# answering on any failure.
#
# The model only ever receives insight.facts — figures already computed by the
# metrics layer — never raw rows.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXABI_AI_ENABLED=true
